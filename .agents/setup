#!/usr/bin/env bash
set -euo pipefail

started_at=$SECONDS

echo "[setup] Checking the landing-page runtime"
for command_name in amp node npm; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "[setup] Required command is unavailable: $command_name" >&2
    exit 1
  fi
done

for entrypoint in index.html landing-source.html document-scan-section.html; do
  if [[ ! -f "$entrypoint" ]]; then
    echo "[setup] Static-site entrypoint is missing: $entrypoint" >&2
    exit 1
  fi
done

echo "[setup] Installing the locked frontend dependencies"
npm ci

echo "[setup] Starting the supervised Vite preview and portal"
amp orb services ensure

echo "[setup] Complete in $((SECONDS - started_at))s"
